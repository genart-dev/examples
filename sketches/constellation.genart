  "snapshots": [],
  "components": {
    "prng": {
      "version": "1.0.0",
      "code": "function mulberry32(a) {\n  return function() {\n    a |= 0; a = a + 0x6D2B79F5 | 0;\n    var t = Math.imul(a ^ a >>> 15, 1 | a);\n    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;\n    return ((t ^ t >>> 14) >>> 0) / 4294967296;\n  };\n}\n\nfunction sfc32(a, b, c, d) {\n  return function() {\n    a |= 0; b |= 0; c |= 0; d |= 0;\n    var t = (a + b | 0) + d | 0;\n    d = d + 1 | 0; a = b ^ (b >>> 9);\n    b = c + (c << 3) | 0; c = (c << 21 | c >>> 11);\n    c = c + t | 0;\n    return (t >>> 0) / 4294967296;\n  };\n}\n",
      "exports": [
        "mulberry32",
        "sfc32"
      ]
    }
  },
  "algorithm": "function sketch(THREE, state, container) {\n  const scene = new THREE.Scene();\n  const bg = new THREE.Color(state.colorPalette[0]);\n  scene.background = bg;\n  scene.fog = new THREE.FogExp2(bg.getHex(), 0.13);\n\n  const camera = new THREE.PerspectiveCamera(62, state.canvas.width / state.canvas.height, 0.1, 100);\n  camera.position.set(0, 0, 3.9);\n\n  const renderer = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });\n  renderer.setSize(state.canvas.width, state.canvas.height);\n  container.appendChild(renderer.domElement);\n\n  // Soft round star sprite built as raw RGBA data (works without a DOM canvas).\n  function makeStarTexture(size) {\n    const data = new Uint8Array(size * size * 4);\n    const c = (size - 1) / 2;\n    for (let y = 0; y < size; y++) {\n      for (let x = 0; x < size; x++) {\n        let dx = (x - c) / c;\n        let dy = (y - c) / c;\n        let d = Math.sqrt(dx * dx + dy * dy);\n        if (d > 1) d = 1;\n        const core = Math.pow(1 - d, 3);\n        const halo = Math.pow(1 - d, 1.4) * 0.35;\n        let a = core + halo;\n        if (a > 1) a = 1;\n        const i = (y * size + x) * 4;\n        data[i] = 255; data[i + 1] = 255; data[i + 2] = 255;\n        data[i + 3] = Math.round(a * 255);\n      }\n    }\n    const tex = new THREE.DataTexture(data, size, size, THREE.RGBAFormat);\n    tex.minFilter = THREE.LinearFilter;\n    tex.magFilter = THREE.LinearFilter;\n    tex.needsUpdate = true;\n    return tex;\n  }\n  const starTex = makeStarTexture(64);\n\n  const group = new THREE.Group();\n  scene.add(group);\n  const stars = [];\n  const accent = new THREE.Color(state.colorPalette[3]);\n\n  // Subtle stellar color temperature: cool blue-white or warm-white.\n  function tempColor(rng) {\n    const col = new THREE.Color();\n    if (rng() < 0.5) col.setRGB(0.80 + 0.2 * rng(), 0.86 + 0.14 * rng(), 1.0);\n    else col.setRGB(1.0, 0.90 + 0.10 * rng(), 0.80 + 0.15 * rng());\n    return col;\n  }\n\n  let linesMesh = null;\n\n  function build() {\n    while (group.children.length) group.remove(group.children[0]);\n    linesMesh = null;\n    stars.length = 0;\n\n    const rng = mulberry32(state.seed);\n    const count = state.params.starCount;\n    const base = state.params.starSize;\n\n    const fieldPos = [], fieldCol = [];\n    const heroPos = [], heroCol = [];\n\n    for (let i = 0; i < count; i++) {\n      const phi = Math.acos(2 * rng() - 1);\n      const theta = rng() * Math.PI * 2;\n      // Fill the whole ball (cbrt = uniform volume density) so the frame reads\n      // full to the corners instead of a hollow shell.\n      const r = 2.15 * Math.cbrt(rng());\n      const x = r * Math.sin(phi) * Math.cos(theta);\n      const y = r * Math.sin(phi) * Math.sin(theta);\n      const z = r * Math.cos(phi);\n      stars.push(new THREE.Vector3(x, y, z));\n\n      // Magnitude: mostly faint, a few bright (power distribution).\n      const mag = Math.pow(rng(), 2.2);\n      const isHero = mag > 0.78;\n      const col = rng() < 0.06 ? accent.clone() : tempColor(rng);\n      col.multiplyScalar(0.35 + mag * 0.65);\n\n      if (isHero) { heroPos.push(x, y, z); heroCol.push(col.r, col.g, col.b); }\n      else { fieldPos.push(x, y, z); fieldCol.push(col.r, col.g, col.b); }\n    }\n\n    group.add(makePoints(fieldPos, fieldCol, base * 1.6));\n    group.add(makePoints(heroPos, heroCol, base * 4.5));\n    buildLines();\n  }\n\n  function makePoints(pos, col, size) {\n    const geo = new THREE.BufferGeometry();\n    geo.setAttribute(\"position\", new THREE.Float32BufferAttribute(pos, 3));\n    geo.setAttribute(\"color\", new THREE.Float32BufferAttribute(col, 3));\n    const mat = new THREE.PointsMaterial({\n      size, map: starTex, vertexColors: true, transparent: true,\n      depthWrite: false, blending: THREE.AdditiveBlending,\n      sizeAttenuation: true, fog: true,\n    });\n    return new THREE.Points(geo, mat);\n  }\n\n  function buildLines() {\n    const threshold = state.params.connectionThreshold;\n    const line = new THREE.Color(state.colorPalette[2]);\n    const verts = [], cols = [];\n    for (let i = 0; i < stars.length; i++) {\n      for (let j = i + 1; j < stars.length; j++) {\n        const d = stars[i].distanceTo(stars[j]);\n        if (d < threshold) {\n          const b = 0.15 + (1 - d / threshold) * 0.85;\n          verts.push(stars[i].x, stars[i].y, stars[i].z, stars[j].x, stars[j].y, stars[j].z);\n          cols.push(line.r * b, line.g * b, line.b * b, line.r * b, line.g * b, line.b * b);\n        }\n      }\n    }\n    const geo = new THREE.BufferGeometry();\n    geo.setAttribute(\"position\", new THREE.Float32BufferAttribute(verts, 3));\n    geo.setAttribute(\"color\", new THREE.Float32BufferAttribute(cols, 3));\n    const mat = new THREE.LineBasicMaterial({\n      vertexColors: true, transparent: true, opacity: 0.55,\n      blending: THREE.AdditiveBlending, depthWrite: false, fog: true,\n    });\n    linesMesh = new THREE.LineSegments(geo, mat);\n    linesMesh.renderOrder = -1;\n    group.add(linesMesh);\n  }\n\n  build();\n\n  function animate() {\n    requestAnimationFrame(animate);\n    group.rotation.y += state.params.orbitSpeed;\n    group.rotation.x += state.params.orbitSpeed * 0.28;\n    renderer.render(scene, camera);\n  }\n  animate();\n\n  return { initializeSystem: build, dispose() { renderer.dispose(); } };\n}"
}
